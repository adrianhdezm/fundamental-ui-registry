{
  "name": "fundamental-ui-registry",
  "version": "0.0.0",
  "private": true,
  "description": "SAP Fiori Horizon components as copy-paste source, distributed as shadcn registries.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "angular": "pnpm --filter @fundamental-ui-registry/angular",
    "react": "pnpm --filter @fundamental-ui-registry/react",
    "check": "pnpm --recursive --workspace-concurrency=1 run check",
    "build-site": "pnpm --recursive --workspace-concurrency=1 run build-storybook && node scripts/build-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "type": "module"
}
