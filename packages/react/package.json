{
  "name": "@fundamental-ui-registry/react",
  "version": "0.0.0",
  "private": true,
  "description": "SAP Fiori Horizon components for React, styled with Tailwind CSS and built on Base UI. Copy the source into your app, shadcn-style.",
  "license": "Apache-2.0",
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "storybook": "pnpm registry:build && storybook dev -p 6007 --no-open",
    "build-storybook": "pnpm registry:build && storybook build -o dist/storybook --quiet",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "check:styles": "node scripts/check-styles.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm check:styles && pnpm registry:check && pnpm test && pnpm test:a11y",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:a11y": "vitest run --project a11y:sap_horizon && vitest run --project a11y:sap_horizon_hcb",
    "visual": "node scripts/visual.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sap-theming/theming-base-content": "11.36.5",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "type": "module"
}
